{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译作业",
      "type": "process",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=.",
        "template_My_Assignment.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "/Library/TeX/texbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "编译笔记",
      "type": "process",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=.",
        "analysis_class-note.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "/Library/TeX/texbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        }
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
