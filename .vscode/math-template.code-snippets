{
  "Math Template: theorem": {
    "scope": "latex",
    "prefix": "mtthm",
    "body": [
      "\\\\begin{theorem}",
      "\t${1:Text.}",
      "\\\\end{theorem}",
      "$0"
    ],
    "description": "Insert a theorem environment"
  },
